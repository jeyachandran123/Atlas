# =============================================================================
# UnityWorks AI Platform
# Environment Configuration
#
# Copy this file to .env and fill in your own values.
# NEVER commit the .env file to version control.
# =============================================================================

# =============================================================================
# Application
# =============================================================================
 
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true

SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# =============================================================================
# Authentication
# =============================================================================

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# PostgreSQL
# =============================================================================

DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_coding_assistant
DB_USER=postgres
DB_PASSWORD=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# TLS to Postgres (libpq sslmode): disable | prefer | require | verify-ca | verify-full.
# Local Docker Postgres has no TLS → disable. Neon / managed Postgres → require.
DB_SSL_MODE=disable

# =============================================================================
# Redis
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# ChromaDB
# =============================================================================

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_AUTH_TOKEN=

# Chroma Cloud instead (hosted deployments). Setting CHROMA_API_KEY switches
# the backend to Chroma Cloud's REST API; copy the other values from the
# Chroma dashboard (Settings → Connect → .env).
# CHROMA_HOST=api.trychroma.com
# CHROMA_PORT=443
# CHROMA_SSL=true
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# Where document embeddings come from. "ollama" uses OLLAMA_EMBED_MODEL on
# your own Ollama; "nvidia" uses NVIDIA's hosted model with NVIDIA_API_KEY,
# for deployments that cannot reach an Ollama. Vectors from the two do not
# mix: pick one per Chroma database.
DIP_EMBEDDING_PROVIDER=ollama
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b

# =============================================================================
# Storage Backend
#
# local      -> Local filesystem
# s3         -> AWS S3
# firebase   -> Firebase Storage
# =============================================================================

STORAGE_BACKEND=local

# --- AWS S3 ---

AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Firebase Storage ---

FIREBASE_STORAGE_BUCKET=

# =============================================================================
# Sign-up & Email (Brevo)
#
# With BREVO_API_KEY and EMAIL_SENDER_ADDRESS set, sign-up emails a 6-digit
# code and the account is created only once it is entered. Without them,
# accounts are created at once and their addresses are not verified.
# The sender must be verified in Brevo (Senders, domains & dedicated IPs);
# authenticating a domain (SPF + DKIM) keeps the codes out of spam.
# =============================================================================

ALLOW_OPEN_REGISTRATION=true
BREVO_API_KEY=
EMAIL_SENDER_ADDRESS=
EMAIL_SENDER_NAME=UnityWorks
SIGNUP_CODE_TTL_SECONDS=600
SIGNUP_RESEND_COOLDOWN_SECONDS=60

# =============================================================================
# Web search (You.com)
#
# Lets chat answer from the live web, with the pages shown as source cards.
# Get a key at https://you.com/platform — the free tier is 100 searches a day.
# With YOU_API_KEY empty, search is simply off and chat behaves as before.
#
# WEB_SEARCH_DAILY_CAP stops below the free tier so a busy day degrades to
# ordinary chat instead of starting a bill.
# =============================================================================

WEB_SEARCH_ENABLED=true
YOU_API_KEY=
WEB_SEARCH_DAILY_CAP=80
WEB_SEARCH_MAX_RESULTS=6
WEB_SEARCH_TIMEOUT_S=12
WEB_SEARCH_COUNTRY=SG

# =============================================================================
# Chat LLM Provider
#
# Supported:
#   ollama
#   nvidia
# =============================================================================

LLM_PROVIDER=ollama

# =============================================================================
# Ollama
# =============================================================================

# OLLAMA_HOST=http://localhost:11434
OLLAMA_HOST=http://192.168.6.118:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_AUTO_MODEL=qwen3:8b
OLLAMA_BUSINESS_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

OLLAMA_TIMEOUT=300
OLLAMA_MAX_RETRIES=3

OLLAMA_NUM_CTX=16384
OLLAMA_NUM_PREDICT=8192

OLLAMA_CHAT_TEMPERATURE=0.3
OLLAMA_CODE_TEMPERATURE=0.15

# =============================================================================
# NVIDIA (Chat Models)
# =============================================================================

NVIDIA_API_KEY=

NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

NVIDIA_CHAT_MODEL=openai/gpt-oss-120b

NVIDIA_TEMPERATURE=1
NVIDIA_TOP_P=1
NVIDIA_MAX_TOKENS=4096

# =============================================================================
# Vision Intelligence
# =============================================================================

# Which provider answers chat vision (/api/v1/chat/stream/vision).
# Separate from LLM_PROVIDER so images can go to a cloud VLM while text chat
# stays on local Ollama. Unset = follow LLM_PROVIDER.
#   ollama -> VISION_MODEL on OLLAMA_HOST
#   nvidia -> NVIDIA_MODEL on NVIDIA_BASE_URL
VISION_PROVIDER=
VISION_MODEL=qwen2.5vl:7b
VISION_STORAGE_DIR=data/vision_uploads

VISION_MAX_IMAGE_SIZE_MB=20
VISION_MAX_IMAGES_PER_MESSAGE=5

# =============================================================================
# Document Vision Language Model
#
# This powers invoice/document extraction.
#
# Supported providers:
#
#   DOCUMENT_VLM_PROVIDER=nvidia
#   DOCUMENT_VLM_PROVIDER=ollama
#   DOCUMENT_VLM_PROVIDER=unityworks
#
# Switching providers requires ONLY changing this value.
# No code changes.
# =============================================================================

DOCUMENT_VLM_PROVIDER=nvidia

# -----------------------------------------------------------------------------
# UnityWorks self-hosted VLM
#
# Used by DOCUMENT_VLM_PROVIDER=unityworks and VISION_PROVIDER=unityworks.
# UNITYWORKS_BASE_URL is the FULL predict endpoint, with no default: a stale
# default would point confidently at someone else's deployment rather than
# failing to start. The key is sent as the X-API-Key header.
# -----------------------------------------------------------------------------

UNITYWORKS_BASE_URL=
UNITYWORKS_API_KEY=
UNITYWORKS_MODEL=unityworks-vlm

# -----------------------------------------------------------------------------
# NVIDIA Document VLM
# -----------------------------------------------------------------------------

NVIDIA_MODEL=minimaxai/minimax-m3
# Model for chat vision (/api/v1/chat/stream/vision) only. Separate from
# NVIDIA_MODEL because llama-3.2-11b-vision replies in under a second but
# accepts ONE image per prompt -- right for chat uploads, wrong for multi-page
# invoice extraction, which stays on NVIDIA_MODEL. Unset = use NVIDIA_MODEL.
NVIDIA_VISION_MODEL=
VISION_NVIDIA_API_KEY=
NVIDIA_IMAGE_FORMAT=image_url
NVIDIA_MAX_INLINE_IMAGE_BYTES=180000
NVIDIA_MAX_IMAGES_PER_REQUEST=4

NVIDIA_PRICE_PER_MILLION_INPUT_TOKENS=0
NVIDIA_PRICE_PER_MILLION_OUTPUT_TOKENS=0

# -----------------------------------------------------------------------------
# Ollama Document VLM
# -----------------------------------------------------------------------------

# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://192.168.6.118:11434
OLLAMA_MODEL=qwen2.5vl:7b

# -----------------------------------------------------------------------------
# Document VLM Runtime
# -----------------------------------------------------------------------------

DOCUMENT_VLM_TIMEOUT_SECONDS=300
DOCUMENT_VLM_CONNECT_TIMEOUT_SECONDS=10

DOCUMENT_VLM_MAX_RETRIES=2
DOCUMENT_VLM_RETRY_BACKOFF_SECONDS=0.5

DOCUMENT_VLM_MAX_OUTPUT_TOKENS=8192
DOCUMENT_VLM_TEMPERATURE=0.0

DOCUMENT_VLM_MAX_FILE_SIZE_MB=20
DOCUMENT_VLM_MAX_PAGES=4

DOCUMENT_VLM_HEALTH_TIMEOUT_SECONDS=10

DOCUMENT_VLM_PROMPT_VERSION=1.0.0

# OCR Provider
#
# Supported:
#   null
#   tesseract
#
DOCUMENT_OCR_PROVIDER=null

# =============================================================================
# Indexing
# =============================================================================

INDEX_MAX_FILE_SIZE_MB=1

INDEX_EMBED_BATCH_SIZE=32
INDEX_PARALLEL_WORKERS=4

INDEX_SKIP_PATTERNS=node_modules,.git,__pycache__,*.pyc,*.min.js,dist,build

# =============================================================================
# Rate Limiting
# =============================================================================

RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_INDEX=5/minute
RATE_LIMIT_SEARCH=60/minute

# =============================================================================
# Observability
# =============================================================================

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

PROMETHEUS_ENABLED=true

LOG_LEVEL=INFO
LOG_FORMAT=json

# =============================================================================
# CORS
# =============================================================================

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:3002,https://atlas-frontend-mauve.vercel.app

# =============================================================================
# Cognitive Operating System
# =============================================================================

COGNITIVE_BRAIN_ENABLED=true