# ─────────────────────────────────────────────────────────────────────────────
# AI Coding Assistant — Environment Configuration
# Copy to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=RS256
# In production: generate RSA key pair
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./infra/keys/private.pem
JWT_PUBLIC_KEY_PATH=./infra/keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_coding_assistant
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_MAX_CONNECTIONS=50

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_AUTH_TOKEN=

# ── Attachment Storage ───────────────────────────────────────────────────────
# local    → files stored under backend/data/ (default)
# s3       → AWS S3 bucket (private; served through the API)
# firebase → Firebase Storage bucket (uses the existing service account JSON)
STORAGE_BACKEND=local

# AWS S3 (STORAGE_BACKEND=s3)
AWS_S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Firebase Storage (STORAGE_BACKEND=firebase)
# Firebase console → Storage → copy the bucket name, e.g.:
# FIREBASE_STORAGE_BUCKET=atlas-ai-assistant-1ae91.firebasestorage.app
FIREBASE_STORAGE_BUCKET=

# ── LLM Provider ─────────────────────────────────────────────────────────────
LLM_PROVIDER=ollama          # ollama | nvidia

# ── Ollama ───────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120
OLLAMA_MAX_RETRIES=3

# ── Indexing ─────────────────────────────────────────────────────────────────
INDEX_MAX_FILE_SIZE_MB=1
INDEX_EMBED_BATCH_SIZE=32
INDEX_PARALLEL_WORKERS=4
INDEX_SKIP_PATTERNS=node_modules,.git,__pycache__,*.pyc,*.min.js,dist,build

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_INDEX=5/minute
RATE_LIMIT_SEARCH=60/minute

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Vision Intelligence ───────────────────────────────────────────────────────
VISION_MODEL=qwen2.5vl:7b
VISION_STORAGE_DIR=data/vision_uploads
VISION_MAX_IMAGE_SIZE_MB=20
VISION_MAX_IMAGES_PER_MESSAGE=5

# ── Document VLM (invoice extraction) ────────────────────────────────────────
# Which implementation answers DocumentVLMPort. Switching providers is this one
# line and a restart — no code change, no redeploy of any ERP integration.
#   nvidia → NVIDIA cloud VLM     (requires NVIDIA_API_KEY)
#   ollama → local Ollama daemon  (requires the model to be pulled)
DOCUMENT_VLM_PROVIDER=nvidia

# NVIDIA cloud VLM. NVIDIA_API_KEY / NVIDIA_BASE_URL are shared with the chat
# provider above; NVIDIA_MODEL is separate because a VLM and a text model are
# different deployments. Point NVIDIA_BASE_URL at a private NIM to keep
# documents inside your own network.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1
# How images are encoded for the model: image_url (OpenAI-compatible, default)
# or inline_html (<img src="data:…"/>, used by some NVIDIA VL endpoints).
NVIDIA_IMAGE_FORMAT=image_url
NVIDIA_MAX_INLINE_IMAGE_BYTES=180000
# Cost estimates stay honest: 0 reports "unpriced" rather than a stale rate.
NVIDIA_PRICE_PER_MILLION_INPUT_TOKENS=0
NVIDIA_PRICE_PER_MILLION_OUTPUT_TOKENS=0

# Ollama local VLM. Separate from OLLAMA_HOST above so document vision can run
# on a GPU box while the chat models stay on the app server.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b

# Call policy — applies to whichever provider is bound.
DOCUMENT_VLM_TIMEOUT_SECONDS=120
DOCUMENT_VLM_CONNECT_TIMEOUT_SECONDS=10
DOCUMENT_VLM_MAX_RETRIES=2
DOCUMENT_VLM_RETRY_BACKOFF_SECONDS=0.5
DOCUMENT_VLM_MAX_OUTPUT_TOKENS=4096
DOCUMENT_VLM_TEMPERATURE=0.0
DOCUMENT_VLM_MAX_FILE_SIZE_MB=20
DOCUMENT_VLM_MAX_PAGES=8
DOCUMENT_VLM_HEALTH_TIMEOUT_SECONDS=10
DOCUMENT_VLM_PROMPT_VERSION=1.0.0

# OCR stage for the extraction pipeline: null (records that OCR was needed
# without performing it) or tesseract (requires the Tesseract binary).
DOCUMENT_OCR_PROVIDER=null
